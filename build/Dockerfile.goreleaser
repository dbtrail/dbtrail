# GoReleaser-only Dockerfile.
#
# Unlike the root ./Dockerfile (which builds from source for `docker build`),
# this image just copies the binaries GoReleaser already cross-compiled. The
# build context root contains `bintrail` and `bintrail-mcp` for the target
# arch — GoReleaser stages them there before invoking `docker build`.
#
# Runtime base matches the root Dockerfile (debian:bookworm-slim) so the
# published image keeps the same contract: glibc for DuckDB's static libs, a
# shell for debugging, and apt for installing mydumper when `dump`/`baseline`
# are used.
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    # Pin uid 999: the bundled compose chowns the index password secret to
    # uid 999 (mode 0600) for this process to read — see docker-compose.yml.
    useradd --system --no-create-home --uid 999 bintrail && \
    # Home dir for the bintrail user: DuckDB caches its httpfs/aws extensions
    # under $HOME/.duckdb for S3 baseline/reconstruct/archive reads and fails
    # INSTALL without one. (The duckdbutil loader pins a fallback if $HOME is missing.)
    mkdir -p /home/bintrail && chown bintrail /home/bintrail

COPY bintrail /usr/local/bin/bintrail
COPY bintrail-mcp /usr/local/bin/bintrail-mcp

# License-compliance notices (#428). GoReleaser stages these into the build
# context via the `dockers.*.extra_files` entries in build/.goreleaser.yaml.
COPY LICENSE NOTICE build/THIRD-PARTY-NOTICES /usr/share/doc/bintrail/

USER bintrail
ENTRYPOINT ["bintrail"]
