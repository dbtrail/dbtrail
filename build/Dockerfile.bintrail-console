# bintrail-console — source-build image (for `docker build` / the compose
# `build:` fallback). The GoReleaser-published image copies prebuilt binaries
# instead; see Dockerfile.bintrail-console.goreleaser.
#
# One binary per image (PMM-style): this image carries ONLY the web-console
# daemon (`serve` = read-only console, `watch` = stream + console + control
# plane). The core CLI ships separately as ghcr.io/dbtrail/bintrail.

# ── Stage 1: build ─────────────────────────────────────────
# Debian-based image required — DuckDB's pre-compiled static libs need glibc.
FROM golang:1.25.11-bookworm AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

WORKDIR /src

# Cache dependency downloads separately from source changes.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 go build \
    -ldflags="-s -w -X main.Version=${VERSION} -X main.CommitSHA=${COMMIT} -X main.BuildDate=${BUILD_DATE}" \
    -o /bintrail-console ./cmd/bintrail-console

# ── Stage 2: runtime ───────────────────────────────────────
# Debian (through the console base image) for glibc compatibility with DuckDB.
# The base image holds Debian, the pinned mydumper with the client library it
# needs, the bintrail user (uid 999) and its directories. It is built and tested
# from build/Dockerfile.console-base, and the tag here is the one in
# build/console-base.tag (a test keeps the two equal). It already runs as the
# bintrail user.
FROM ghcr.io/dbtrail/bintrail-console-base:bookworm-mydumper1.0.3-1-r1

COPY --from=builder /bintrail-console /usr/local/bin/bintrail-console

# License-compliance notices (#428): our license + retained upstream notices
# for the statically-linked MIT/MPL-2.0/BSD dependencies (DuckDB et al.).
COPY --from=builder /src/LICENSE /src/NOTICE /src/THIRD-PARTY-NOTICES /usr/share/doc/bintrail-console/

USER bintrail
ENTRYPOINT ["bintrail-console"]
