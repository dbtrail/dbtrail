# GoReleaser-only Dockerfile for the bintrail-console image.
#
# Unlike Dockerfile.bintrail-console (which builds from source for
# `docker build`), this image just copies the binary GoReleaser already
# cross-compiled. The build context root contains `bintrail-console` for the
# target arch — GoReleaser stages it there before invoking `docker build`.
#
# Runtime base matches Dockerfile.bintrail-console (the console base image,
# Debian bookworm): glibc for DuckDB's static libs and a shell for debugging. One binary per
# image (PMM-style) — the core CLI ships as ghcr.io/dbtrail/bintrail.
# The base image holds Debian, the pinned mydumper with the client library it
# needs, the bintrail user (uid 999) and its directories. It is built and tested
# from build/Dockerfile.console-base, and the tag here is the one in
# build/console-base.tag (a test keeps the two equal). It already runs as the
# bintrail user.
FROM ghcr.io/dbtrail/bintrail-console-base:bookworm-mydumper1.0.3-1-r1

COPY bintrail-console /usr/local/bin/bintrail-console

# License-compliance notices (#428). GoReleaser stages these into the build
# context via the `dockers.*.extra_files` entries in build/.goreleaser.yaml.
COPY LICENSE NOTICE build/THIRD-PARTY-NOTICES /usr/share/doc/bintrail-console/

USER bintrail
ENTRYPOINT ["bintrail-console"]
