# Settings of the bintrail-console service (DBTrail: capture and web interface).
# systemd reads this file: one NAME=value per line, and nothing is expanded.
# A value with a space, a quote or a backslash in it goes in 'single quotes'.
# A comment is a whole line: text after a value becomes part of the value.
# After a change: sudo systemctl restart bintrail-console

# REQUIRED. The index MySQL (8.0 or newer) DBTrail writes to. Its account needs
# to create databases: bintrail_index, and one bintrail_idx_<id> per server.
# Example: dbtrail:password@tcp(127.0.0.1:3306)/bintrail_index
BINTRAIL_INDEX_DSN=

# Where the web interface listens. 127.0.0.1 answers on this machine only.
BINTRAIL_CONSOLE_LISTEN=127.0.0.1:8090

# To open it to other machines, listen on 0.0.0.0:8090 and name every host name
# people type (comma separated, no spaces). IP addresses always work.
#BINTRAIL_CONSOLE_ALLOWED_HOSTS=dbtrail.example.com

# The first visitor creates the username and password. On 127.0.0.1 that is
# always allowed. On any other address it needs this line, so keep the port
# closed to everyone else until the login exists.
#BINTRAIL_CONSOLE_ALLOW_SETUP=1

# What DBTrail saves: the servers you add, the login, Claude's token. Back up
# /var/lib/bintrail, and move it with DBTrail if you change machines.
BINTRAIL_CONSOLE_SERVERS=/var/lib/bintrail/console-servers.yaml
BINTRAIL_CONSOLE_AUTH=/var/lib/bintrail/console-auth.yaml
BINTRAIL_CONSOLE_MCP_TOKEN_FILE=/var/lib/bintrail/console-mcp-token.yaml

# Work folders. A full read stages about the size of your data, uncompressed,
# so point this at a disk with that much room.
BINTRAIL_CONSOLE_BASELINE_STAGING=/var/lib/bintrail/baseline-staging
BINTRAIL_CONSOLE_ARCHIVE_STAGING=/var/lib/bintrail/archives

# Turns on "Read database now" and the checks in the web interface. A full read
# runs the mydumper found on this service's PATH.
BINTRAIL_CONSOLE_BASELINE_TRIGGER=1
BINTRAIL_CONSOLE_VERIFY_TRIGGER=1

# Prometheus metrics. Off unless set.
#BINTRAIL_METRICS_ADDR=127.0.0.1:9090

# ---- bintrail-router.service (the MySQL port, 3309) ----
# A second service of this package that reads this same file. It answers MySQL
# clients and applications, and it is the only thing that does: the capture
# service does not open the port. The package starts it. It accepts no
# connection until you turn the port on in the web interface.
# Where it listens. On this machine only unless changed.
#BINTRAIL_ROUTER_LISTEN=127.0.0.1:3309
# It refuses every statement that is not a read. 0 forwards writes too, with
# each server's forwarding account (set on the server, in the web interface)
# and never with the account DBTrail captures with.
#BINTRAIL_CONSOLE_ROUTE_READ_ONLY=0
# Its numbers (who answered, the copy's age, its workers) and its Prometheus
# metrics. The web interface reads them from the second address, so change
# both together, then restart both services. The second line is read by
# bintrail-console.service.
#BINTRAIL_ROUTER_METRICS_ADDR=127.0.0.1:9091
#BINTRAIL_CONSOLE_ROUTER_URL=http://127.0.0.1:9091
