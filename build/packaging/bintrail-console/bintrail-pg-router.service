# Installed by the bintrail-console package. To change a setting, edit
# /etc/bintrail/bintrail-console.env. To change the unit itself, use
# `systemctl edit bintrail-pg-router`, which survives upgrades; this file does
# not.
#
# The PostgreSQL router is the PostgreSQL port (5433): PostgreSQL clients and
# applications connect to it to read the copy of a PostgreSQL server. It is a
# service of its own, as the MySQL port's is, so that restarting capture does
# not drop its connections and a statement that runs out of memory here cannot
# take capture with it. The package enables and starts it; it accepts no
# connection until the port for SQL clients is turned on in the web interface,
# and with MySQL or MariaDB servers it has nothing to answer for and waits.
[Unit]
Description=DBTrail PostgreSQL router: the PostgreSQL port
Documentation=https://www.dbtrail.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bintrail
Group=bintrail
# The same file the capture service reads, so both use the same servers file.
EnvironmentFile=/etc/bintrail/bintrail-console.env
ExecStart=/usr/bin/bintrail-console pg-router
WorkingDirectory=/var/lib/bintrail
# Applications connect through this port, so nothing but a stop asked of
# systemd ends it.
Restart=always
RestartSec=5
TimeoutStopSec=30
# Hands the control groups below this unit to the service, which gives each
# statement on the copy a memory ceiling of its own (see bintrail-router).
Delegate=yes
# Small unless told otherwise: two statements at once, two threads each
# (BINTRAIL_PG_ROUTER_WORKERS and BINTRAIL_PG_ROUTER_THREADS in the settings
# file). For a ceiling on the whole service, `systemctl edit
# bintrail-pg-router` and set, under [Service], for example:
#   MemoryMax=8G
#   CPUQuota=400%

[Install]
WantedBy=multi-user.target
