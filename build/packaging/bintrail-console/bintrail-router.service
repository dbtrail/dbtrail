# Installed by the bintrail-console package. To change a setting, edit
# /etc/bintrail/bintrail-console.env. To change the unit itself, use
# `systemctl edit bintrail-router`, which survives upgrades; this file does not.
#
# The router is the MySQL port with read routing, as a service of its own:
# applications connect to it in place of their MySQL server. It is separate
# from bintrail-console.service on purpose, so that restarting capture does not
# drop its connections and a statement that runs out of memory here cannot
# take capture with it. It is not started when the package is installed:
#   sudo systemctl enable --now bintrail-router
[Unit]
Description=DBTrail router: the MySQL port with read routing
Documentation=https://www.dbtrail.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bintrail
Group=bintrail
# Read-only unless the settings file says otherwise: a statement that is not
# a read is refused and never reaches the source. A line in the settings file
# wins over this one; BINTRAIL_CONSOLE_ROUTE_READ_ONLY=0 there forwards writes.
Environment=BINTRAIL_CONSOLE_ROUTE_READ_ONLY=1
# The same file the capture service reads, so both use the same servers file.
EnvironmentFile=/etc/bintrail/bintrail-console.env
ExecStart=/usr/bin/bintrail-console router
WorkingDirectory=/var/lib/bintrail
# Applications connect through this port, so nothing but a stop asked of
# systemd ends it.
Restart=always
RestartSec=5
TimeoutStopSec=30
# Hands the control groups below this unit to the service, which gives each
# statement on the copy a memory ceiling of its own. That needs a systemd that
# marks the group it hands over: 255 (Ubuntu 24.04) does, 249 (Ubuntu 22.04)
# does not, and the service says which at start.
Delegate=yes
# No ceiling of its own by default: it sizes itself from half of the machine,
# since capture uses the machine too. To give it one, `systemctl edit
# bintrail-router` and set, under [Service], for example:
#   MemoryMax=8G
#   CPUQuota=400%
# It then uses all of what it was given.

[Install]
WantedBy=multi-user.target
